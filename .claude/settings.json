{
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Edit(**/auth-schema.ts)",
      "Write(**/auth-schema.ts)",
      "Edit(**/drizzle/**)",
      "Write(**/drizzle/**)"
    ],
    "allow": [
      "Bash(npm run *)",
      "Bash(npm view *)",
      "Bash(npx tsc *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose up -d*)",
      "Bash(docker compose exec *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(curl -s https://api.github.com/repos/YukiOnishi1129/*)",
      "Bash(curl -s https://raw.githubusercontent.com/YukiOnishi1129/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in */Fridgy-mvp/frontend/*) cd /Users/daichi/Workspace/study/myapp/Fridgy-mvp/frontend && ./node_modules/.bin/prettier --write --ignore-unknown \"$f\" ;; esac; } 2>/dev/null || true",
            "statusMessage": "prettier"
          }
        ]
      }
    ]
  }
}
