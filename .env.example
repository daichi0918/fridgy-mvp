# このファイルをコピーして .env を作る
#   cp .env.example .env
# .env は .gitignore 済み（コミットされない）

# ---------------------------------------------------------------------------
# Database（ローカル開発用の Postgres コンテナ）
# ---------------------------------------------------------------------------
DB_CONTAINER_NAME=fridgy-mvp-db
DB_USER=fridgy
DB_PASSWORD=password
DB_NAME=fridgy_mvp

# ホスト側のポート。標準の 5432 が他プロジェクトと衝突する場合はここを変える
DB_PORT=5433

# アプリからの接続先
# ⚠️ ${DB_USER} のような変数展開は使わないこと。
#    docker compose は展開できるが、Node の dotenv は展開しないため
#    アプリ側で文字列 "${DB_USER}" のまま読み込まれてしまう。
DATABASE_URL=postgresql://fridgy:password@localhost:5433/fridgy_mvp
