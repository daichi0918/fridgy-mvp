# このファイルをコピーして .env.local を作る
#   cp .env.example .env.local
#
# ⚠️ リポジトリ直下の /.env とは別物。
#    /.env            … docker compose だけが読む（DBコンテナの設定）
#    frontend/.env.local … Next.js / drizzle-kit / better-auth が読む
#    Next.js は frontend/ の外にある .env を見ないため、両方が必要。

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# ローカルは docker compose の Postgres（ホスト側ポートは 5433）
DATABASE_URL=postgresql://fridgy:password@localhost:5433/fridgy_mvp

# ---------------------------------------------------------------------------
# better-auth
# ---------------------------------------------------------------------------
# セッション暗号化などに使う秘密鍵。次のコマンドで生成する:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth（ステップ7で設定する。それまでは空でよい）
# ---------------------------------------------------------------------------
# Google Cloud Console > APIとサービス > 認証情報 で OAuth クライアントIDを作成し、
# 承認済みリダイレクトURIに以下を登録する:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
