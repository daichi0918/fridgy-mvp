{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:types && npm run check:lint && npm run check:format && npm run check:deps",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint",
    "check:format": "prettier --check .",
    "check:deps": "if grep -rqE 'from \"(next|react|drizzle|pg|better-auth)' src/external/domain/; then echo '❌ domain 層が外部に依存している'; grep -rnE 'from \"(next|react|drizzle|pg|better-auth)' src/external/domain/; exit 1; else echo '✅ domain は外部に依存していない'; fi",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/external/client/database/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
